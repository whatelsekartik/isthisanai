{
  "functions": {
    "api/*.mjs": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "runtime/model/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/bench",
      "destination": "/bench.html"
    }
  ]
}
